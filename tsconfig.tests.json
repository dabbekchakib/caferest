{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist-tests",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": [
    "tests/**/*.ts",
    "src/lib/auth/*.ts",
    "src/lib/authorization/*.ts",
    "src/lib/units/*.ts",
    "src/lib/categories/*.ts",
    "src/lib/products/*.ts",
    "src/lib/ingredients/*.ts",
    "src/lib/recipes/*.ts",
    "src/lib/yields/*.ts",
    "src/lib/suppliers/*.ts",
    "src/lib/purchases/*.ts",
    "src/lib/stocktakes/*.ts",
    "src/lib/stock-adjustments/*.ts",
    "src/lib/tables/*.ts",
    "src/lib/floor-plan/*.ts",
    "src/validations/recipes.ts",
    "src/validations/yields.ts",
    "src/validations/suppliers.ts",
    "src/validations/purchases.ts",
    "src/validations/stocktakes.ts",
    "src/validations/stock-adjustments.ts",
    "src/validations/tables.ts",
    "src/lib/validation/zod-resolver.ts",
    "src/validations/auth.ts"
  ]
}
