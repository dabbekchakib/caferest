NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never NEXT_PUBLIC_*, never committed). Required for the
# administration features (user provisioning) — see src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI bridge (scripts/supabase-cli.mjs) — optional, for db:push etc.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_DATABASE_PASSWORD=
